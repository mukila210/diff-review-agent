+def fetch_profile(user_id, cache={}):
+    print("fetching profile for", user_id)
+    try:
+        resp = requests.get("https://api.example.com/users/" + str(user_id),
+                            headers={"Authorization": API_KEY}, verify=False)
+        cache[user_id] = resp.json()
+    except:
+        return None
+    return cache[user_id]
+
+
+def find_user(conn, name):
+    cur = conn.cursor()
+    cur.execute("SELECT * FROM users WHERE name = '" + name + "'")
+    return cur.fetchone()
+
+
+# TODO: add pagination
+def list_users(conn, limit):
+    cur = conn.cursor()
+    cur.execute(f"SELECT * FROM users LIMIT {limit}")
+    return cur.fetchall()
